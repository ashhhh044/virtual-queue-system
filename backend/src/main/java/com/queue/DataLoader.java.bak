package com.queue;

import com.queue.model.*;
import com.queue.repository.*;
import org.springframework.boot.CommandLineRunner;
import org.springframework.stereotype.Component;
import org.springframework.transaction.annotation.Transactional;

@Component
public class DataLoader implements CommandLineRunner {
    
    private final UserRepository userRepository;
    private final CustomerRepository customerRepository;
    private final ServiceRepository serviceRepository;
    
    public DataLoader(UserRepository userRepository, 
                      CustomerRepository customerRepository,
                      ServiceRepository serviceRepository) {
        this.userRepository = userRepository;
        this.customerRepository = customerRepository;
        this.serviceRepository = serviceRepository;
    }
    
    @Override
    @Transactional
    public void run(String... args) throws Exception {
        System.out.println("Loading sample data...");
        
        // Create a sample customer
        if (!userRepository.existsByEmail("john@example.com")) {
            Customer customer = new Customer();
            customer.setName("John Doe");
            customer.setEmail("john@example.com");
            customer.setPassword("password123");
            customer.setPhone("1234567890");
            customer.setPriority("normal");
            customer.setAccessKey("ABC123XYZ");
            customer.setTokenNumber("T001");
            customer.setRole("CUSTOMER");
            
            customerRepository.save(customer);
            System.out.println("✅ Customer created: John Doe");
        }
        
        // Create a sample service
        if (!serviceRepository.findByName("General").isPresent()) {
            Service service = new Service();
            service.setName("General");
            service.setDescription("General customer service");
            service.setEstimatedDuration(10);
            
            serviceRepository.save(service);
            System.out.println("✅ Service created: General");
        }
        
        System.out.println("✅ Sample data loaded successfully!");
    }
}